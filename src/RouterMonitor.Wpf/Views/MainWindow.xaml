<Window x:Class="RouterMonitor.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Router Monitor" Height="720" Width="1080" MinHeight="560" MinWidth="820"
        Closing="OnWindowClosing"
        Background="{StaticResource Brush.Window}">
    <DockPanel>
        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.StatusBar}" Padding="0">
            <StackPanel>
                <ProgressBar Style="{StaticResource ConnectionProgressBar}" Value="{Binding ConnectionProgress}"
                             Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}" />
                <Grid Margin="10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Brush.Danger}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" />
                        <TextBlock Text=" - " Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"
                                   Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding ConnectionStageText}" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"
                                   Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text=" · ostatnia aktualizacja: " Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LastUpdatedText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Ponów teraz" Margin="14,0,0,0" Command="{Binding RetryNowCommand}" />
                </Grid>
            </StackPanel>
        </Border>

        <TabControl Margin="12">
            <TabItem Header="Pulpit">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4">
                        <WrapPanel Margin="0,8,0,0">
                            <Border Style="{StaticResource TileStyle}">
                                <StackPanel>
                                    <TextBlock Text="MODEL / FIRMWARE" Style="{StaticResource TileLabel}" />
                                    <TextBlock Text="{Binding Model}" Style="{StaticResource TileValue}" />
                                    <TextBlock Text="{Binding Firmware}" Style="{StaticResource TileSubValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TileStyle}">
                                <StackPanel>
                                    <TextBlock Text="CZAS PRACY" Style="{StaticResource TileLabel}" />
                                    <TextBlock Text="{Binding Uptime}" Style="{StaticResource TileValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TileStyle}">
                                <StackPanel>
                                    <TextBlock Text="WAN IP / BRAMA" Style="{StaticResource TileLabel}" />
                                    <TextBlock Text="{Binding WanIp}" Style="{StaticResource TileValue}" />
                                    <TextBlock Text="{Binding Gateway}" Style="{StaticResource TileSubValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TileStyle}">
                                <StackPanel>
                                    <TextBlock Text="DNS" Style="{StaticResource TileLabel}" />
                                    <TextBlock Text="{Binding Dns}" Style="{StaticResource TileValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TileStyle}">
                                <StackPanel>
                                    <TextBlock Text="POBIERANIE" Style="{StaticResource TileLabel}" />
                                    <TextBlock Text="{Binding DownstreamText}" Style="{StaticResource TileValue}" Foreground="{StaticResource Brush.Accent}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TileStyle}">
                                <StackPanel>
                                    <TextBlock Text="WYSYŁANIE" Style="{StaticResource TileLabel}" />
                                    <TextBlock Text="{Binding UpstreamText}" Style="{StaticResource TileValue}" Foreground="{StaticResource Brush.AccentAlt}" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <ItemsControl ItemsSource="{Binding WifiBands}" Margin="0,0,0,10">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TileStyle}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource TileLabel}" />
                                            <TextBlock Text="{Binding Ssid}" Style="{StaticResource TileValue}" />
                                            <TextBlock Text="{Binding Encryption}" Style="{StaticResource TileSubValue}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Urządzenia w sieci" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <DataGrid ItemsSource="{Binding Devices}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" RowHeight="28" MinHeight="180">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nazwa" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Adres IP" Binding="{Binding IpAddress}" Width="1.2*" />
                                <DataGridTextColumn Header="Adres MAC" Binding="{Binding MacAddress}" Width="1.5*" />
                                <DataGridTextColumn Header="Połączenie" Binding="{Binding ConnectionType}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Limity">
                <DockPanel Margin="4">
                    <StackPanel DockPanel.Dock="Top" Margin="0,8,0,8">
                        <TextBlock Text="Limity prędkości urządzeń" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource TileSubValue}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Wpisz maksymalną prędkość w Mb/s (puste pole = bez limitu w tym kierunku) i kliknij Zapisz. Limit działa w routerze, także gdy ten komputer jest wyłączony. Zapis trwa 1–2 minuty, bo router odpowiada wolno." />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Odśwież" Command="{Binding RefreshRateLimitsCommand}" />
                            <TextBlock Text="{Binding RateLimitStatus}" Style="{StaticResource TileSubValue}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="RateLimitList" ItemsSource="{Binding RateLimits}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TileStyle}" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource TileValue}" />
                                                <TextBlock Text="{Binding Meta}" Style="{StaticResource TileSubValue}" />
                                                <TextBlock Text="{Binding CurrentText}" Margin="0,4,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TileSubValue}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasLimit}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Message}" Style="{StaticResource TileSubValue}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                                                <TextBlock Text="↓" Style="{StaticResource TileValue}" Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <TextBox Text="{Binding DownloadText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LimitInput}" ToolTip="Pobieranie (Mb/s)" />
                                                <TextBlock Text="↑" Style="{StaticResource TileValue}" Foreground="{StaticResource Brush.AccentAlt}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                                <TextBox Text="{Binding UploadText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LimitInput}" ToolTip="Wysyłanie (Mb/s)" />
                                                <TextBlock Text="Mb/s" Style="{StaticResource TileSubValue}" VerticalAlignment="Center" Margin="6,0,12,0" />
                                                <Button Content="Zapisz" Margin="0,0,8,0"
                                                        Command="{Binding DataContext.SaveRateLimitCommand, ElementName=RateLimitList}" CommandParameter="{Binding}" />
                                                <Button Content="Usuń limit"
                                                        Command="{Binding DataContext.RemoveRateLimitCommand, ElementName=RateLimitList}" CommandParameter="{Binding}"
                                                        Visibility="{Binding HasLimit, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="Zarządzanie">
                <StackPanel Margin="4">
                    <TextBlock Text="Dostęp z telefonu" FontWeight="SemiBold" Margin="0,8,0,4" />
                    <Border Style="{StaticResource TileStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="ADRES" Style="{StaticResource TileLabel}" />
                            <TextBox Text="{Binding WebAccessUrl, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     Foreground="{StaticResource Brush.TextPrimary}" FontSize="16" FontWeight="SemiBold" Padding="0" />
                            <TextBlock Text="PIN" Style="{StaticResource TileLabel}" Margin="0,8,0,0" />
                            <TextBox Text="{Binding WebAccessPin, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     Foreground="{StaticResource Brush.TextPrimary}" FontSize="16" FontWeight="SemiBold" Padding="0" />
                            <TextBlock Text="{Binding WebAccessStatus}" Style="{StaticResource TileSubValue}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Router" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Border Style="{StaticResource TileStyle}" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Uruchom ponownie router" Command="{Binding RebootRouterCommand}"
                                    Background="{StaticResource Brush.Danger}" Foreground="White" BorderThickness="0" />
                            <TextBlock Text="Router zrestartuje się natychmiast - internet i WiFi będą niedostępne przez chwilę."
                                       Style="{StaticResource TileSubValue}" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Nieaktywne urządzenia" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Odśwież" Margin="0,0,8,0" Command="{Binding LoadInactiveDevicesCommand}" />
                        <Button Content="Zaznacz wszystkie" Margin="0,0,8,0" Command="{Binding SelectAllInactiveCommand}" />
                        <Button Content="Odznacz wszystkie" Margin="0,0,8,0" Command="{Binding DeselectAllInactiveCommand}" />
                        <Button Content="Usuń zaznaczone" Command="{Binding DeleteSelectedInactiveCommand}"
                                Background="{StaticResource Brush.Danger}" Foreground="White" BorderThickness="0" />
                    </StackPanel>
                    <TextBlock Text="{Binding ManageStatusMessage}" Style="{StaticResource TileSubValue}" Margin="0,0,0,8" />

                    <DataGrid ItemsSource="{Binding InactiveDevices}" AutoGenerateColumns="False" IsReadOnly="False"
                              CanUserAddRows="False" HeadersVisibility="Column" RowHeight="28" MinHeight="220">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Usuń" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                            <DataGridTextColumn Header="Nazwa" Binding="{Binding Name}" Width="2*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Adres IP" Binding="{Binding IpAddress}" Width="1.2*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Adres MAC" Binding="{Binding MacAddress}" Width="1.5*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Połączenie" Binding="{Binding ConnectionType}" Width="2*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
