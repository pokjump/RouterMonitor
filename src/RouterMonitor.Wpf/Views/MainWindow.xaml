<Window x:Class="RouterMonitor.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RouterMonitor.Wpf.Controls"
        Title="Router Monitor" Height="720" Width="1080" MinHeight="560" MinWidth="820"
        Closing="OnWindowClosing"
        Background="#F4F6F8">
    <Window.Resources>
        <Style x:Key="TileStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="BorderBrush" Value="#E0E4E8" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#1F2937" Padding="10,6">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#EF4444" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                    <Setter Property="Fill" Value="#22C55E" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusMessage}" Foreground="White" VerticalAlignment="Center" />
                <TextBlock Text=" · ostatnia aktualizacja: " Foreground="#9CA3AF" VerticalAlignment="Center" />
                <TextBlock Text="{Binding LastUpdatedText}" Foreground="White" VerticalAlignment="Center" />
                <Button Content="Ponów teraz" Padding="10,2" Margin="14,0,0,0" Command="{Binding RetryNowCommand}" />
            </StackPanel>
        </Border>

        <TabControl Margin="12">
            <TabItem Header="Pulpit">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4">
                        <WrapPanel Margin="0,8,0,0">
                            <Border Style="{StaticResource TileStyle}">
                                <StackPanel>
                                    <TextBlock Text="MODEL / FIRMWARE" Style="{StaticResource TileLabel}" />
                                    <TextBlock Text="{Binding Model}" Style="{StaticResource TileValue}" />
                                    <TextBlock Text="{Binding Firmware}" FontSize="11" Foreground="#6B7280" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TileStyle}">
                                <StackPanel>
                                    <TextBlock Text="CZAS PRACY" Style="{StaticResource TileLabel}" />
                                    <TextBlock Text="{Binding Uptime}" Style="{StaticResource TileValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TileStyle}">
                                <StackPanel>
                                    <TextBlock Text="WAN IP / BRAMA" Style="{StaticResource TileLabel}" />
                                    <TextBlock Text="{Binding WanIp}" Style="{StaticResource TileValue}" />
                                    <TextBlock Text="{Binding Gateway}" FontSize="11" Foreground="#6B7280" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TileStyle}">
                                <StackPanel>
                                    <TextBlock Text="DNS" Style="{StaticResource TileLabel}" />
                                    <TextBlock Text="{Binding Dns}" Style="{StaticResource TileValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TileStyle}">
                                <StackPanel>
                                    <TextBlock Text="POBIERANIE" Style="{StaticResource TileLabel}" />
                                    <TextBlock Text="{Binding DownstreamText}" Style="{StaticResource TileValue}" Foreground="#2563EB" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TileStyle}">
                                <StackPanel>
                                    <TextBlock Text="WYSYŁANIE" Style="{StaticResource TileLabel}" />
                                    <TextBlock Text="{Binding UpstreamText}" Style="{StaticResource TileValue}" Foreground="#C2185B" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <ItemsControl ItemsSource="{Binding WifiBands}" Margin="0,0,0,10">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TileStyle}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource TileLabel}" />
                                            <TextBlock Text="{Binding Ssid}" Style="{StaticResource TileValue}" />
                                            <TextBlock Text="{Binding Encryption}" FontSize="11" Foreground="#6B7280" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Transfer" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <Border Background="White" BorderBrush="#E0E4E8" BorderThickness="1" CornerRadius="6" Padding="10" Height="120">
                            <controls:TransferChart Downstream="{Binding DownstreamHistory}" Upstream="{Binding UpstreamHistory}" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,14">
                            <Rectangle Width="10" Height="10" Fill="DodgerBlue" Margin="0,0,4,0" />
                            <TextBlock Text="Pobieranie" Margin="0,0,14,0" FontSize="11" Foreground="#6B7280" />
                            <Rectangle Width="10" Height="10" Fill="MediumVioletRed" Margin="0,0,4,0" />
                            <TextBlock Text="Wysyłanie" FontSize="11" Foreground="#6B7280" />
                        </StackPanel>

                        <TextBlock Text="Urządzenia w sieci" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <DataGrid ItemsSource="{Binding Devices}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="28" MinHeight="180">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nazwa" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Adres IP" Binding="{Binding IpAddress}" Width="1.2*" />
                                <DataGridTextColumn Header="Adres MAC" Binding="{Binding MacAddress}" Width="1.5*" />
                                <DataGridTextColumn Header="Połączenie" Binding="{Binding ConnectionType}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Historia">
                <StackPanel Margin="4">
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,10">
                        <TextBlock Text="Data:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <DatePicker SelectedDate="{Binding HistoryDate}" Width="140" />
                        <Button Content="Odśwież" Margin="10,0,0,0" Padding="10,4" Command="{Binding LoadHistoryCommand}" />
                    </StackPanel>
                    <TextBlock Text="Kto był w sieci danego dnia" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <DataGrid ItemsSource="{Binding HistoryDevices}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="28">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nazwa" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Adres IP" Binding="{Binding IpAddress}" Width="1.2*" />
                            <DataGridTextColumn Header="Adres MAC" Binding="{Binding Mac}" Width="1.5*" />
                            <DataGridTextColumn Header="Połączenie" Binding="{Binding ConnectionType}" Width="1.5*" />
                            <DataGridTextColumn Header="Pierwszy raz" Binding="{Binding FirstSeenInRange}" Width="1.3*" />
                            <DataGridTextColumn Header="Ostatni raz" Binding="{Binding LastSeenInRange}" Width="1.3*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>

            <TabItem Header="Zarządzanie">
                <StackPanel Margin="4">
                    <TextBlock Text="Router" FontWeight="SemiBold" Margin="0,8,0,4" />
                    <Border Background="White" BorderBrush="#E0E4E8" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Uruchom ponownie router" Padding="12,6" Command="{Binding RebootRouterCommand}"
                                    Background="#EF4444" Foreground="White" BorderThickness="0" />
                            <TextBlock Text="Router zrestartuje się natychmiast - internet i WiFi będą niedostępne przez chwilę."
                                       Foreground="#6B7280" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Nieaktywne urządzenia" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Odśwież" Padding="10,4" Margin="0,0,8,0" Command="{Binding LoadInactiveDevicesCommand}" />
                        <Button Content="Zaznacz wszystkie" Padding="10,4" Margin="0,0,8,0" Command="{Binding SelectAllInactiveCommand}" />
                        <Button Content="Odznacz wszystkie" Padding="10,4" Margin="0,0,8,0" Command="{Binding DeselectAllInactiveCommand}" />
                        <Button Content="Usuń zaznaczone" Padding="10,4" Command="{Binding DeleteSelectedInactiveCommand}"
                                Background="#EF4444" Foreground="White" BorderThickness="0" />
                    </StackPanel>
                    <TextBlock Text="{Binding ManageStatusMessage}" Foreground="#6B7280" FontSize="11" Margin="0,0,0,8" />

                    <DataGrid ItemsSource="{Binding InactiveDevices}" AutoGenerateColumns="False" IsReadOnly="False"
                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="28" MinHeight="220">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Usuń" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                            <DataGridTextColumn Header="Nazwa" Binding="{Binding Name}" Width="2*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Adres IP" Binding="{Binding IpAddress}" Width="1.2*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Adres MAC" Binding="{Binding MacAddress}" Width="1.5*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Połączenie" Binding="{Binding ConnectionType}" Width="2*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
